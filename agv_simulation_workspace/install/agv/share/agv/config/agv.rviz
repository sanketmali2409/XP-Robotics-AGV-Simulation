Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Plane Cell Count: 20
      Cell Size: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Robot 1 (EKF)
      Value: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot1/robot_description
    - Class: rviz_default_plugins/RobotModel
      Name: Robot 2 (LiDAR)
      Value: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot2/robot_description
    - Class: rviz_default_plugins/RobotModel
      Name: Robot 3 (Hybrid SLAM)
      Value: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot3/robot_description
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Value: false
      Topic: /odom
      Keep: 100
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: RPLidar
      Topic:
        Depth: 5
        Durability Policy: System Default
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /robot2/scan
      Value: true
      Size (Pixels): 5
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
      Update Topic: /map_updates
      Color Scheme: map
      Draw Behind: false
      Resolution: 0.0
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 3.0
      Pitch: 0.78
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  X: 100
  Y: 100
